#!/bin/sh
# Import GPG keys from 1Password.
# Idempotent: skips entirely (no 1Password unlock) when the key is already in
# the keyring. Reads secrets at runtime via `op`, only when the key is missing.
# Requires: gnupg installed, `op` CLI signed in.
# gpg: {{ lookPath "gpg" }}  (re-runs once gpg gets installed)

set -eu

if ! command -v gpg >/dev/null 2>&1; then
    echo "gpg not installed, skipping import"
    exit 0
fi

{{ if lookPath "op" -}}
# Key fingerprint is public info, hardcoded so the already-imported guard runs
# WITHOUT touching 1Password (no unlock prompt on every chezmoi apply).
KEY_ID="1EEF79895C978A0B"

# Skip import entirely if both public and secret keys are already in the keyring.
# This returns before any `op` call, so 1Password stays locked.
if gpg --list-keys "$KEY_ID" >/dev/null 2>&1 \
    && gpg --list-secret-keys "$KEY_ID" >/dev/null 2>&1; then
    echo "GPG key $KEY_ID already imported, skipping"
    exit 0
fi

# Key missing — fetch from 1Password at runtime (this is what triggers unlock).
# Values are normally stored base64-encoded (single line) so 1Password can't
# mangle the armor's newlines, but a raw armored block is accepted too.
# Byte-level tools must not choke on non-UTF-8 garbage from a failed decode.
export LC_ALL=C

# Print armored key material for a 1Password reference, or nothing.
fetch_key() {
    raw=$(op read "$1" 2>/dev/null || true)
    [ -n "$raw" ] || return 0
    decoded=$(printf '%s' "$raw" | base64 -d 2>/dev/null || true)
    case "$decoded" in
        *"BEGIN PGP"*) printf '%s\n' "$decoded" ;;
        *) case "$raw" in
               *"BEGIN PGP"*) printf '%s\n' "$raw" ;;
               *) echo "$1: value is neither an armored key nor base64 of one, skipping" >&2 ;;
           esac ;;
    esac
}

PUBLIC_KEY=$(fetch_key "op://Private/GPG Key/public_key")
PRIVATE_KEY=$(fetch_key "op://Private/GPG Key/private_key")

if [ -n "$PUBLIC_KEY" ]; then
    printf '%s\n' "$PUBLIC_KEY" | gpg --import --batch || echo "Public key import failed, continuing"
else
    echo "Public key not available in 1Password, skipping"
fi

if [ -n "$PRIVATE_KEY" ]; then
    printf '%s\n' "$PRIVATE_KEY" | gpg --import --batch || echo "Private key import failed, continuing"
else
    echo "Private key not available in 1Password, skipping"
fi

# Mark key ultimately trusted (own key) if it's now in the keyring.
# import-ownertrust needs the full 40-char fingerprint, not the long keyid.
if [ -n "$KEY_ID" ] && gpg --list-keys "$KEY_ID" >/dev/null 2>&1; then
    FPR=$(gpg --with-colons --fingerprint "$KEY_ID" 2>/dev/null \
        | awk -F: '/^fpr:/{print $10; exit}')
    if [ -n "$FPR" ]; then
        echo "${FPR}:6:" | gpg --import-ownertrust || echo "Ownertrust set failed, continuing"
    fi
fi
{{- else }}
echo "op CLI not installed, skipping GPG import"
exit 0
{{- end }}
