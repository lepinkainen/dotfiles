#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""
unpack — extract (almost) any archive into the current directory.

  * Format is detected by extension first, then by `file` magic bytes,
    so misnamed/extensionless archives still work.
  * If an archive would scatter multiple loose entries into $PWD, unpack
    automatically creates a subdirectory named after the archive and
    extracts there. A single top-level file/dir is left in place.
  * Single-stream compressors (.gz/.bz2/.xz/.zst/...) decompress to one
    file (the extension is stripped) and the original is kept.

Usage:
  unpack [options] <archive> [archive...] [-- passthru-args]

Options:
  -C, --directory DIR   extract into DIR (created if needed)
  -i, --in-place        never auto-create a subdir; extract into $PWD
  -l, --list            list contents instead of extracting
  -f, --force           overwrite existing destination files/dirs
  -v, --verbose         verbose output from the underlying tool
  -q, --quiet           suppress progress and the "-> ..." summary line
  -h, --help            show this help

Supported: tar tar.gz/tgz tar.bz2/tbz tar.xz/txz tar.zst/tzst tar.lz
tar.lzma tar.Z, zip jar war ear apk epub xpi crx whl egg ipa kmz, 7z,
rar, cpio, iso, xar/pkg/xip, ar/deb, gz bz2 xz zst lz4 lzip lzma Z.

Engine preference: bsdtar > format-specific tool (tar/unzip/7zz/unrar/...).
RAR is proprietary: install `unar` (brew install unar) for complete support.
The `rar` cask is Gatekeeper-blocked on macOS; `unar` (a formula) is not.
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PROG = "unpack"
DEVNULL = subprocess.DEVNULL
HELP = (__doc__ or "").strip()

# Single-stream compressors: decompress to one file, keep the original.
STREAM_KINDS = {"gz", "bz2", "xz", "zst", "lz4", "lzip", "lzma", "compress"}

# Container-format extension groups (checked longest/compound suffix first).
TAR_SUFFIXES = (".tar.gz", ".tgz", ".tar.bz2", ".tbz", ".tbz2", ".tar.xz", ".txz",
                ".tar.zst", ".tzst", ".tar.lz", ".tar.lzma", ".tar.lzo", ".tar.z",
                ".taz", ".tar")
ZIP_SUFFIXES = (".zip", ".jar", ".war", ".ear", ".apk", ".epub", ".xpi", ".crx",
                ".whl", ".egg", ".ipa", ".kmz", ".docx", ".docm", ".xlsx", ".xlsm",
                ".pptx", ".pptm", ".odt", ".ods", ".odp")
# For stripping an archive extension off a name (longest first so .tar.gz wins).
STRIP_SUFFIXES = (".tar.gz", ".tar.bz2", ".tar.xz", ".tar.zst", ".tar.lzma",
                  ".tar.lz", ".tar.lzo", ".tar.z", ".tgz", ".tbz2", ".tbz", ".txz",
                  ".tzst", ".taz", ".tar", *ZIP_SUFFIXES, ".7z", ".7zip", ".rar",
                  ".cpio", ".iso", ".xar", ".pkg", ".xip", ".gz", ".bz2", ".xz",
                  ".zstd", ".zst", ".lz4", ".lzip", ".lzma", ".zz", ".z")


def die(msg):
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(1)


def have(cmd):
    return shutil.which(cmd) is not None


def need(cmd):
    if not have(cmd):
        die(f"required tool not found: {cmd} (install it and retry)")


# Resolve the 7-Zip binary (Homebrew's 7zip formula installs it as '7zz').
SEVENZ = next((c for c in ("7zz", "7z", "7za", "7zr") if have(c)), None)


def need7z():
    if not SEVENZ:
        die("7-Zip not found (brew install 7zip)")


def sh(cmd):
    """Run a command, inheriting stdio (so tool output/progress shows). -> ok?"""
    return subprocess.run(cmd).returncode == 0


def cmd_ok(cmd):
    """Run a command silently. -> ok?"""
    return subprocess.run(cmd, stdout=DEVNULL, stderr=DEVNULL).returncode == 0


def capture(cmd):
    """Run a command, return (ok, stdout_bytes)."""
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=DEVNULL)
    return r.returncode == 0, r.stdout


# ---- format detection -------------------------------------------------------
def tar_inside(f):
    """Is the (compressed) file actually a tar inside? Non-destructive probe."""
    tool = "bsdtar" if have("bsdtar") else "tar" if have("tar") else None
    return bool(tool) and cmd_ok([tool, "tf", str(f)])


def detect_by_magic(f):
    ok, out = capture(["file", "-b", "--mime-type", str(f)])
    mt = out.decode("ascii", "replace").strip() if ok else ""
    fixed = {
        "application/x-tar": "tar",
        "application/x-7z-compressed": "7z",
        "application/zip": "zip",
        "application/x-zip-compressed": "zip",
        "application/x-cpio": "cpio",
        "application/x-iso9660-image": "iso",
        "application/x-xar": "xar",
        "application/x-lzip": "lzip",
        "application/x-lzma": "lzma",
        "application/x-lz4": "lz4",
        "application/x-compress": "compress",
    }
    if mt in fixed:
        return fixed[mt]
    if mt.startswith(("application/gzip", "application/x-gzip")):
        return "tar" if tar_inside(f) else "gz"
    if mt == "application/x-bzip2":
        return "tar" if tar_inside(f) else "bz2"
    if mt == "application/x-xz":
        return "tar" if tar_inside(f) else "xz"
    if mt.startswith(("application/zstd", "application/x-zstd")):
        return "tar" if tar_inside(f) else "zst"
    if mt == "application/vnd.rar" or mt.startswith("application/x-rar"):
        return "rar"
    return None


def detect_kind(f):
    """Return a KIND keyword for the file. Extension first, magic fallback."""
    ln = Path(f).name.lower()
    if ln.endswith(TAR_SUFFIXES):
        return "tar"
    if ln.endswith(ZIP_SUFFIXES):
        return "zip"
    if ln.endswith((".7z", ".7zip")):
        return "7z"
    if ln.endswith((".rar", ".r00", ".cbr")):
        return "rar"
    if ln.endswith(".cpio"):
        return "cpio"
    if ln.endswith(".iso"):
        return "iso"
    if ln.endswith((".xar", ".pkg", ".xip")):
        return "xar"
    if ln.endswith((".ar", ".deb")):
        return "ar"
    if ln.endswith(".gz"):
        return "tar" if tar_inside(f) else "gz"
    if ln.endswith(".bz2"):
        return "tar" if tar_inside(f) else "bz2"
    if ln.endswith(".xz"):
        return "tar" if tar_inside(f) else "xz"
    if ln.endswith((".zst", ".zstd")):
        return "tar" if tar_inside(f) else "zst"
    if ln.endswith(".lz4"):
        return "lz4"
    if ln.endswith(".lz"):
        return "lzip"
    if ln.endswith(".lzma"):
        return "tar" if tar_inside(f) else "lzma"
    if ln.endswith((".z", ".zz")):
        return "compress"
    return detect_by_magic(f)


def strip_ext(name):
    """Strip a known archive extension from a filename."""
    ln = name.lower()
    for suf in STRIP_SUFFIXES:
        if ln.endswith(suf):
            return name[: len(name) - len(suf)]
    stem = Path(name).stem
    return stem or name


# ---- listing ----------------------------------------------------------------
def list_contents(f, kind):
    f = str(f)
    if kind in ("tar", "cpio", "iso", "xar", "7z", "rar"):
        if have("bsdtar") and subprocess.run(["bsdtar", "tf", f]).returncode == 0:
            return
    if kind == "tar":
        need("tar"); subprocess.run(["tar", "tf", f]); return
    if kind == "zip":
        need("unzip"); subprocess.run(["unzip", "-Z1", f]); return
    if kind == "7z":
        need7z(); subprocess.run([SEVENZ, "l", f]); return
    if kind == "rar":
        if have("unrar"):
            subprocess.run(["unrar", "l", f])
        else:
            need7z(); subprocess.run([SEVENZ, "l", f])
        return
    if kind == "cpio":
        if have("bsdtar"):
            subprocess.run(["bsdtar", "tf", f])
        else:
            die("need bsdtar or libarchive for cpio")
        return
    if kind == "iso":
        if have("bsdtar"):
            subprocess.run(["bsdtar", "tf", f])
        else:
            need7z(); subprocess.run([SEVENZ, "l", f])
        return
    if kind == "xar":
        if have("xar"):
            subprocess.run(["xar", "-tf", f])
        else:
            need("bsdtar"); subprocess.run(["bsdtar", "tf", f])
        return
    if kind == "ar":
        need("ar"); subprocess.run(["ar", "t", f]); return
    die(f"cannot list single-file stream ({kind}); just decompress it")


def rar_expected_count(f):
    """Regular-file count from 7zz's listing summary ('N files, M folders').
    Used to detect a silent partial RAR extraction. 0 = unknown (skip check)."""
    if not SEVENZ:
        return 0
    ok, out = capture([SEVENZ, "l", str(f)])
    if not ok:
        return 0
    for line in out.decode("utf-8", "replace").splitlines():
        toks = line.split()
        for i, t in enumerate(toks):
            if t == "files," and i > 0:
                try:
                    return int(toks[i - 1])
                except ValueError:
                    return 0
    return 0


def toplevels(f, kind):
    """Unique top-level entry names (bytes) for the subdir-safety check.
    Works in bytes throughout so non-UTF-8 archive names never raise."""
    raw = b""
    if kind in ("tar", "zip", "cpio", "iso", "xar", "7z", "rar"):
        if have("bsdtar"):
            ok, raw = capture(["bsdtar", "tf", str(f)])
            if not ok:
                raw = b""
        if not raw:
            if kind == "zip" and have("unzip"):
                _, raw = capture(["unzip", "-Z1", str(f)])
            elif kind == "7z" and SEVENZ:
                _, out = capture([SEVENZ, "l", "-slt", str(f)])
                raw = b"\n".join(
                    line[len(b"Path = "):]
                    for line in out.splitlines()
                    if line.startswith(b"Path = ")
                )
            elif kind == "rar" and have("unrar"):
                _, raw = capture(["unrar", "lb", str(f)])
    tops = set()
    for line in raw.split(b"\n"):
        line = line.replace(b"\\", b"/")
        if line.startswith(b"./"):
            line = line[2:]
        if not line:
            continue
        first = line.split(b"/", 1)[0]
        if first:
            tops.add(first)
    return tops


# ---- extraction -------------------------------------------------------------
def extract_attempt(f, kind, dest, verbose, passthru, quiet):
    """Extract one archive into <dest>. Returns True on success."""
    f, dest = str(f), str(dest)
    v = ["-v"] if verbose else []
    if kind == "tar":
        need("tar")
        return sh(["tar", *v, "xf", f, "-C", dest, *passthru])
    if kind == "zip":
        if have("unzip"):
            q = [] if verbose else ["-q"]
            return sh(["unzip", "-o", *q, f, "-d", dest, *passthru])
        need("bsdtar")
        return sh(["bsdtar", *v, "xf", f, "-C", dest])
    if kind == "7z":
        if SEVENZ:
            return sh([SEVENZ, "x", "-y", f"-o{dest}", f])
        need("bsdtar")
        return sh(["bsdtar", *v, "xf", f, "-C", dest])
    if kind == "rar":
        # RAR is proprietary. Prefer the complete decoders (unrar, then unar);
        # bsdtar/7zz can silently produce a partial extraction, so bsdtar gets a
        # completeness check and 7zz is the last resort.
        if have("unrar"):
            return sh(["unrar", "x", "-y", f, dest + "/"])
        if have("unar"):
            # -D never wraps in an extra dir, -f overwrite, -o out dir.
            cmd = ["unar", "-D", "-f", "-o", dest, f]
            r = subprocess.run(cmd, stdout=DEVNULL, stderr=DEVNULL) if quiet \
                else subprocess.run(cmd)
            if r.returncode == 0:
                return True
            shutil.rmtree(dest, ignore_errors=True)
            os.makedirs(dest, exist_ok=True)
        if have("bsdtar"):
            if sh(["bsdtar", *v, "xf", f, "-C", dest]):
                exp = rar_expected_count(f)
                act = sum(1 for p in Path(dest).rglob("*") if p.is_file())
                if exp > 0 and act < exp:
                    print(f"{PROG}: RAR incomplete ({act} of {exp} files) for "
                          f"{Path(f).name}", file=sys.stderr)
                    return False
                return True
            shutil.rmtree(dest, ignore_errors=True)
            os.makedirs(dest, exist_ok=True)
        if SEVENZ and sh([SEVENZ, "x", "-y", f"-o{dest}", f]):
            return True
        return False
    if kind == "cpio":
        if have("bsdtar"):
            return sh(["bsdtar", *v, "xf", f, "-C", dest])
        need("cpio")
        with open(f, "rb") as fh:
            return subprocess.run(["cpio", "-idmu", *v], cwd=dest,
                                  stdin=fh).returncode == 0
    if kind == "iso":
        if SEVENZ:
            return sh([SEVENZ, "x", "-y", f"-o{dest}", f])
        need("bsdtar")
        return sh(["bsdtar", *v, "xf", f, "-C", dest])
    if kind == "xar":
        if have("xar"):
            return sh(["xar", "-xf", f, "-C", dest])
        need("bsdtar")
        return sh(["bsdtar", *v, "xf", f, "-C", dest])
    if kind == "ar":
        need("ar")
        return subprocess.run(["ar", "xv" if verbose else "x", f],
                              cwd=dest).returncode == 0
    die(f"internal: unknown container kind '{kind}'")


def move_into(src, dest):
    """Move the contents of <src> into <dest> (created if needed), dotfiles
    included. Used when the destination is shared (cwd or -C dir)."""
    dest = Path(dest)
    dest.mkdir(parents=True, exist_ok=True)
    for entry in list(Path(src).iterdir()):
        target = dest / entry.name
        if target.is_symlink() or target.is_file():
            target.unlink()
        elif target.is_dir():
            shutil.rmtree(target)
        shutil.move(str(entry), str(target))


def decompress_stream(f, kind, dest, force, quiet):
    """Decompress a single stream to <dest>/<name-without-ext>, keep original."""
    out = Path(dest) / strip_ext(Path(f).name)
    if out.exists() and not force:
        die(f"refusing to overwrite existing '{out}' (use -f)")
    f = str(f)
    if kind == "gz":
        need("gunzip"); argv = ["gunzip", "-c", f]
    elif kind == "bz2":
        need("bunzip2"); argv = ["bunzip2", "-c", f]
    elif kind == "xz":
        argv = ["xz", "-dc", f] if have("xz") else (need("unxz"), ["unxz", "-c", f])[1]
    elif kind == "zst":
        argv = ["zstd", "-dc", f] if have("zstd") else (need("unzstd"), ["unzstd", "-c", f])[1]
    elif kind == "lz4":
        need("lz4"); argv = ["lz4", "-dc", f]
    elif kind == "lzip":
        if not have("lzip"):
            die("need 'lzip' for .lz (brew install lzip)")
        argv = ["lzip", "-dc", f]
    elif kind == "lzma":
        argv = ["unlzma", "-c", f] if have("unlzma") else (need("xz"), ["xz", "-dc", f])[1]
    elif kind == "compress":
        need("gzip"); argv = ["gzip", "-dc", f]
    else:
        die(f"internal: unknown stream kind '{kind}'")
    with open(out, "wb") as o:
        if subprocess.run(argv, stdout=o).returncode != 0:
            out.unlink(missing_ok=True)
            die(f"failed to decompress '{f}'")
    if not quiet:
        print(f"{PROG}: {Path(f).name} -> {out}")


# ---- main -------------------------------------------------------------------
def process(arc, opts):
    p = Path(arc)
    if not p.exists():
        die(f"no such file: {arc}")
    if not p.is_file():
        die(f"not a regular file: {arc}")
    kind = detect_kind(arc)
    if not kind:
        die(f"could not detect archive type: {arc}")

    if opts.list:
        list_contents(arc, kind)
        return

    # Single-stream compressors are handled separately.
    if kind in STREAM_KINDS:
        dest = opts.directory or "."
        if opts.directory:
            os.makedirs(opts.directory, exist_ok=True)
        decompress_stream(arc, kind, dest, opts.force, opts.quiet)
        return

    if not opts.quiet:
        tag = f"[{opts._idx}/{opts._total}] " if opts._total > 1 else ""
        print(f"{PROG}: {tag}unpacking {p.name} ...", file=sys.stderr)

    # Container archive: decide the destination directory.
    own_dest = False
    if opts.directory:
        local_dest = opts.directory
        os.makedirs(local_dest, exist_ok=True)
    elif opts.in_place:
        local_dest = "."
    else:
        # Auto-subdir if the archive would scatter multiple top-level entries.
        if len(toplevels(arc, kind)) > 1:
            local_dest = strip_ext(p.name) or "unpacked"
            if Path(local_dest).exists():
                if not opts.force:
                    die(f"destination '{local_dest}' exists (use -f to overwrite, "
                        f"or -C/-i)")
                if Path(local_dest).is_dir() and not Path(local_dest).is_symlink():
                    shutil.rmtree(local_dest)
                else:
                    Path(local_dest).unlink()
            own_dest = True
        else:
            local_dest = "."

    final_dest = os.path.abspath(local_dest)

    # Stage extraction in a temp dir on the SAME filesystem as the destination,
    # then commit only on success — a failing/partial tool never leaves
    # half-extracted files behind.
    if local_dest == ".":
        stage_parent = "."
    else:
        stage_parent = os.path.dirname(local_dest) or "."
        os.makedirs(stage_parent, exist_ok=True)
    stage = tempfile.mkdtemp(prefix=".unpack.", dir=stage_parent)

    try:
        if extract_attempt(arc, kind, stage, opts.verbose, opts.passthru, opts.quiet):
            if own_dest:
                if os.path.exists(final_dest):
                    shutil.rmtree(final_dest, ignore_errors=True)
                shutil.move(stage, final_dest)
                stage = None
            else:
                move_into(stage, final_dest)
            if not opts.quiet:
                print(f"{PROG}: {p.name} -> {local_dest}")
        elif kind == "rar":
            die(f"failed to extract RAR '{arc}': no complete RAR tool succeeded; "
                f"install unar (brew install unar) or unrar")
        else:
            die(f"failed to extract '{arc}' ({kind})")
    finally:
        if stage and os.path.isdir(stage):
            shutil.rmtree(stage, ignore_errors=True)


def main():
    argv = sys.argv[1:]
    # Everything after the first "--" is passed through to the underlying tool.
    if "--" in argv:
        i = argv.index("--")
        left, passthru = argv[:i], argv[i + 1:]
    else:
        left, passthru = argv, []

    ap = argparse.ArgumentParser(prog=PROG, add_help=False)
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("-l", "--list", action="store_true")
    ap.add_argument("-i", "--in-place", dest="in_place", action="store_true")
    ap.add_argument("-f", "--force", action="store_true")
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("-q", "--quiet", action="store_true")
    ap.add_argument("-C", "--directory", default="")
    ap.add_argument("archives", nargs="*")
    opts = ap.parse_args(left)

    if opts.help:
        print(HELP)
        sys.exit(0)
    if not opts.archives:
        print(HELP, file=sys.stderr)
        sys.exit(1)
    if not (have("bsdtar") or have("tar")):
        die("no 'tar' or 'bsdtar' found")

    opts.passthru = passthru
    opts._total = len(opts.archives)
    for idx, arc in enumerate(opts.archives, 1):
        opts._idx = idx
        process(arc, opts)


if __name__ == "__main__":
    main()
