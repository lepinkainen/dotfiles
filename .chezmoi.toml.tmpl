{{/* Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
     Fresh machine: the only thing needed before `chezmoi init --apply` is the
     age private key at ~/.config/chezmoi/key.txt (copy from another machine /
     1Password, or `chezmoi age-keygen`). Until it exists, encrypted targets are
     skipped (see .chezmoiignore). Everything else (Homebrew, mise, tools) is
     installed by the apply itself.
     The private key is never committed; only public keys live in key/recipients.txt. */}}
encryption = "age"

[data]
    email = "riku.lindblad@iki.fi"
    name = "Riku Lindblad"

[diff]
    # A pager with spaces runs via the shell, so this works before delta is
    # installed (mise bootstrap installs it during the first apply) and
    # switches to delta automatically afterwards. No re-init needed.
    pager = "command -v delta >/dev/null 2>&1 && delta || less"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipientsFile = "{{ .chezmoi.sourceDir }}/key/recipients.txt"

{{ if eq .chezmoi.os "darwin" -}}
[scriptEnv]
    # Scripts run by `chezmoi apply` must find brew/mise-installed tools (go,
    # gpg, npm, fish, op) even on a fresh machine whose shell PATH does not
    # include Homebrew yet.
    PATH = "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:{{ .chezmoi.homeDir }}/bin:{{ .chezmoi.homeDir }}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{ end -}}
